<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Dependable bookkeeping support for small businesses, including monthly bookkeeping, account reconciliation, cleanup, and financial reporting.">
  <title>Blen Woldearegay Bookkeeping | Bookkeeping Support</title>
  <style>
    :root { --green:#142B4A; --green2:#176B70; --cream:#F5F7FA; --sage:#E4F2EF; --ink:#202B3C; --muted:#5E6B7C; --white:#fff; --gold:#F2B84B; --line:#DCE4ED; }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { margin:0; font-family:Arial,Helvetica,sans-serif; color:var(--ink); line-height:1.6; background:#fff; }
    a { color:inherit; }
    .wrap { width:min(1100px, 90%); margin:auto; }
    header { background:var(--white); border-bottom:1px solid var(--line); box-shadow:0 2px 12px rgba(20,43,74,.04); position:sticky; top:0; z-index:5; }
    .nav { min-height:72px; display:flex; align-items:center; justify-content:space-between; gap:20px; }
    .brand { font-weight:800; text-decoration:none; color:var(--green); letter-spacing:-.3px; }
    nav { display:flex; gap:22px; flex-wrap:wrap; }
    nav a { text-decoration:none; font-size:.94rem; color:#33445B; }
    nav a:hover { color:var(--green2); text-decoration:underline; text-decoration-color:var(--gold); text-underline-offset:5px; }
    .hero { background:radial-gradient(ellipse at 85% 10%, rgba(242,184,75,.20), transparent 32%), linear-gradient(120deg,#10233F 0%,#173F5F 54%,#176B70 100%); color:#fff; padding:92px 0 84px; position:relative; overflow:hidden; }
    .eyebrow { text-transform:uppercase; letter-spacing:2px; font-size:.78rem; font-weight:700; color:#F7D88D; }
    h1 { font-size:clamp(2.4rem,6vw,4.6rem); line-height:1.04; letter-spacing:-2px; max-width:780px; margin:18px 0; }
    .hero p { font-size:1.15rem; max-width:680px; color:#eef4ef; }
    .hero-objectives { max-width:760px; padding-left:22px; color:#eef4ef; }
    .hero-objectives li { margin:12px 0; padding-left:4px; }
    .hero-objectives strong { color:#F7D88D; }
    .actions { display:flex; gap:12px; flex-wrap:wrap; margin-top:28px; }
    .btn { display:inline-block; border-radius:8px; padding:13px 19px; text-decoration:none; font-weight:700; border:2px solid transparent; transition:transform .18s ease, box-shadow .18s ease; }
    .btn:hover { transform:translateY(-2px); box-shadow:0 8px 22px rgba(0,0,0,.15); }
    .btn-primary { background:var(--gold); color:#142B4A; box-shadow:0 5px 16px rgba(242,184,75,.22); }
    .btn-outline { color:white; border-color:rgba(255,255,255,.65); background:rgba(255,255,255,.06); }
    section { padding:70px 0; }
    .soft { background:var(--cream); }
    .section-intro { max-width:720px; margin-bottom:30px; }
    h2 { color:#142B4A; font-size:clamp(1.8rem,4vw,2.6rem); line-height:1.15; margin:0 0 14px; letter-spacing:-.7px; }
    .lead { font-size:1.08rem; color:var(--muted); }
    .cards { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
    .card { background:#fff; border:1px solid var(--line); border-radius:13px; padding:25px; box-shadow:0 6px 20px rgba(20,43,74,.045); transition:transform .18s ease, box-shadow .18s ease; }
    .card:hover { transform:translateY(-3px); box-shadow:0 12px 28px rgba(20,43,74,.10); }
    .card .symbol { display:inline-grid; place-items:center; width:44px; height:44px; border-radius:12px; font-size:1.5rem; color:var(--green2); background:var(--sage); }
    h3 { margin:10px 0 8px; color:#142B4A; font-size:1.18rem; }
    .card p { margin:0; color:var(--muted); }
    .about-grid { display:grid; grid-template-columns:220px minmax(0,1fr) .85fr; gap:30px; align-items:center; }
    .profile-photo { display:block; width:100%; max-width:220px; aspect-ratio:3/4; object-fit:cover; object-position:center 24%; border-radius:16px; border:4px solid white; box-shadow:0 12px 30px rgba(20,43,74,.14); }
    .promise { background:linear-gradient(145deg,#E4F2EF,#F3F8F7); border:1px solid #CBE4DF; border-left:5px solid var(--gold); padding:28px; border-radius:14px; }
    .promise ul { padding-left:20px; margin-bottom:0; }
    .contact-grid { display:grid; grid-template-columns:1fr 1fr; gap:35px; }
    .contact-panel { border-radius:14px; padding:28px; background:linear-gradient(145deg,#142B4A,#176B70); color:white; box-shadow:0 12px 30px rgba(20,43,74,.16); }
    .contact-panel h3 { color:white; margin-top:0; }
    .contact-panel p { color:#e7f0e9; }
    .contact-panel a { color:white; }
    .contact-form { display:grid; gap:13px; }
    label { display:grid; gap:6px; font-weight:700; font-size:.93rem; }
    input,select,textarea { width:100%; border:1px solid #C7D3E0; border-radius:7px; padding:12px; font:inherit; background:#fff; color:var(--ink); }
    textarea { min-height:115px; resize:vertical; }
    button { cursor:pointer; font:inherit; }
    .submit { background:var(--gold); color:#142B4A; border:0; border-radius:7px; padding:13px 18px; font-weight:800; box-shadow:0 5px 14px rgba(242,184,75,.18); }
    .submit:hover { background:#FFD16E; }
    .fineprint { font-size:.85rem; color:var(--muted); }
    footer { background:#0C1B30; color:#E7EDF5; padding:26px 0; font-size:.9rem; }
    footer .wrap { display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap; }
    @media (max-width:700px) {
      .nav { padding:14px 0; align-items:flex-start; flex-direction:column; }
      nav { gap:13px; }
      .hero { padding:62px 0; }
      section { padding:52px 0; }
      .cards,.about-grid,.contact-grid { grid-template-columns:1fr; }
      .profile-photo { max-width:190px; margin:0 auto; }
      h1 { letter-spacing:-1px; }
    }
  </style>
</head>
<body>
  <header>
    <div class="wrap nav">
      <a class="brand" href="#home">Blen Woldearegay Bookkeeping</a>
      <nav aria-label="Main navigation">
        <a href="#services">Services</a><a href="#about">About</a><a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero" id="home">
      <div class="wrap">
        <div class="eyebrow">Practical bookkeeping support</div>
        <h1>Clear books. Better business decisions.</h1>
        <p>Value-driven bookkeeping support, committed to serving small business owners with excellence. My focus is on two key objectives:</p>
        <ul class="hero-objectives">
          <li><strong>Support increased profitability:</strong> identify opportunities to improve results, with a target of up to $7,500 in potential annual value through eligible tax-deduction awareness and cost reduction. Results vary by business; tax advice and outcomes are not guaranteed.</li>
          <li><strong>Make better use of your time:</strong> keep financial records organized so you can spend more time running and growing your business.</li>
        </ul>
        <div class="actions">
          <a class="btn btn-primary" href="#contact">Request a consultation</a>
          <a class="btn btn-outline" href="#services">Explore services</a>
        </div>
      </div>
    </section>

    <section id="services">
      <div class="wrap">
        <div class="section-intro">
          <h2>Bookkeeping that supports your business</h2>
          <p class="lead">Whether you need ongoing support or help getting your records back on track, services can be tailored to your needs and agreed scope.</p>
        </div>
        <div class="cards">
          <article class="card"><div class="symbol" aria-hidden="true">▦</div><h3>Monthly bookkeeping</h3><p>Routine transaction categorization and organized financial records to help you stay up to date.</p></article>
          <article class="card"><div class="symbol" aria-hidden="true">✓</div><h3>Account reconciliation</h3><p>Reconcile bank and credit card accounts and investigate discrepancies within the agreed scope.</p></article>
          <article class="card"><div class="symbol" aria-hidden="true">↻</div><h3>Bookkeeping cleanup</h3><p>Bring overdue or disorganized records into better order with a clear, agreed cleanup plan.</p></article>
          <article class="card"><div class="symbol" aria-hidden="true">▤</div><h3>Financial reports</h3><p>Prepare useful bookkeeping reports that help business owners review income, expenses, and financial activity.</p></article>
        </div>
      </div>
    </section>

    <section class="soft" id="about">
      <div class="wrap about-grid">
        <div class="profile-wrap">
          <img class="profile-photo" src="data:image/jpeg;base64," alt="Professional portrait of Blen Woldearegay" loading="lazy">
        </div>
        <div>
          <h2>Meet Blen</h2>
          <p class="lead">Experience, care, and attention to detail</p>
          <p class="lead">With more than 20 years of experience in financial management, budgeting, accounting, and financial reporting, I understand the importance of accurate, organized financial records.</p>
          <p>But I also understand that a business is about more than numbers. It represents an owner’s hard work, sacrifices, hopes, and dreams for the future. That’s why I approach every client’s finances with care, diligence, respect, and confidentiality, recognizing the trust you place in me and the vision you are building.</p>
          <p>My goal is to bring clarity to your books, provide peace of mind, and give you more time to focus on what matters most—your business. I would be honored to work alongside you and support you as you pursue your goals and dreams for your business.</p>
        </div>
        <aside class="promise">
          <h3>A straightforward approach</h3>
          <ul>
            <li>Understand your needs first</li>
            <li>Agree on the scope of work</li>
            <li>Keep records organized</li>
            <li>Communicate clearly and professionally</li>
          </ul>
        </aside>
      </div>
    </section>

    <section id="contact">
      <div class="wrap contact-grid">
        <div>
          <h2>Let's talk about your bookkeeping</h2>
          <p class="lead">Tell me a little about your business and the support you need. I’ll follow up to discuss next steps.</p>
          <p><strong>Email:</strong> <a href="mailto:blenexcellentbookkeeping@gmail.com">blenexcellentbookkeeping@gmail.com</a></p>
          <p><strong>Phone:</strong> <a href="tel:+16173089560">617-308-9560</a></p>
          <p><strong>Service area:</strong> Washington, DC area and remote clients (edit to match your service area).</p>
          <p class="fineprint">Please do not include passwords, bank account numbers, tax identification numbers, or other sensitive financial information in this form.</p>
        </div>
        <div class="contact-panel">
          <h3>Request a consultation</h3>
          <p>Complete the short form and your email app will open with your inquiry ready to send.</p>
          <form class="contact-form" id="inquiry">
            <label>Your name<input name="name" autocomplete="name" required></label>
            <label>Business name<input name="business" autocomplete="organization"></label>
            <label>Email address<input name="email" type="email" autocomplete="email" required></label>
            <label>What do you need help with?
              <select name="service">
                <option>Monthly bookkeeping</option><option>Bookkeeping cleanup</option><option>Account reconciliation</option><option>Financial reports</option><option>Other / not sure yet</option>
              </select>
            </label>
            <label>Brief message<textarea name="message" required></textarea></label>
            <button class="submit" type="submit">Prepare my inquiry</button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap"><span>© <span id="year"></span> Blen Woldearegay Bookkeeping</span><span>Professional bookkeeping support</span></div>
  </footer>
  <script>
    document.getElementById('year').textContent = new Date().getFullYear();
    document.getElementById('inquiry').addEventListener('submit', function(e) {
      e.preventDefault();
      const d = new FormData(this);
      const subject = encodeURIComponent('Bookkeeping consultation inquiry');
      const body = encodeURIComponent(
        'Name: ' + d.get('name') + '\\nBusiness: ' + d.get('business') +
        '\\nEmail: ' + d.get('email') + '\\nService: ' + d.get('service') +
        '\\nMessage: ' + d.get('message')
      );
      window.location.href = 'mailto:blenexcellentbookkeeping@gmail.com?subject=' + subject + '&body=' + body;
    });
  </script>
</body>
</html>
